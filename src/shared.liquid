{% template flashcard %}
  {% case size %}
    {% when "full" %}
      {% assign hanzi_size = "text--giga" %}
      {% assign pinyin_size = "text--xlarge" %}
      {% assign english_size = "text--xlarge" %}
    {% when "half-horizontal" %}
      {% assign hanzi_size = "text--mega" %}
      {% assign pinyin_size = "text--large" %}
      {% assign english_size = "text--base" %}
    {% when "half-vertical" %}
      {% assign hanzi_size = "text--mega" %}
      {% assign pinyin_size = "text--large" %}
      {% assign english_size = "text--large" %}
    {% else %}
      {% assign hanzi_size = "text--xxxlarge" %}
      {% assign pinyin_size = "text--large" %}
      {% assign english_size = "text--base" %}
  {% endcase %}
  <div class="layout layout--col layout--center flashcard flashcard--{{ size }}">
    <span class="label label--small flashcard__level">HSK {{ hsk }}</span>
    <span class="{{ hanzi_size }} text--bold flashcard__hanzi">{{ traditional }}</span>
    <span class="{{ pinyin_size }} flashcard__pinyin">{{ pinyin }}</span>
    <div class="flashcard__rule"></div>
    <span class="{{ english_size }} flashcard__english" data-clamp="4">{{ english }}</span>
  </div>

  <div class="title_bar">
    <span class="title">中文詞卡</span>
    <span class="instance">Traditional Chinese</span>
  </div>
{% endtemplate %}

<style>
  .flashcard {
    text-align: center;
    gap: 8px;
  }

  .flashcard__level {
    border: 2px solid #000;
    border-radius: 5px;
    padding: 2px 9px;
    letter-spacing: 0.08em;
  }

  .flashcard__hanzi {
    font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  .flashcard__pinyin {
    font-weight: 500;
    line-height: 1.15;
  }

  .flashcard__rule {
    width: 72px;
    border-top: 3px solid #000;
    margin: 5px 0;
  }

  .flashcard__english {
    max-width: 680px;
    font-weight: 500;
    line-height: 1.22;
  }

  .flashcard--half-horizontal .flashcard__english {
    max-width: 620px;
  }

  .flashcard--half-vertical .flashcard__english {
    max-width: 320px;
  }

  .flashcard--quadrant {
    gap: 5px;
  }

  .flashcard--quadrant .flashcard__rule {
    width: 48px;
    margin: 2px 0;
  }

  .flashcard--quadrant .flashcard__english {
    max-width: 300px;
  }
</style>
